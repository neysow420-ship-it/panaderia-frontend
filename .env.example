# Plantilla del frontend. Copiar a `.env` y ajustar los valores.
# Nunca subir `.env` al repositorio.

# URL base de la API Rust (sin barra final).
VITE_API_URL=http://localhost:3000

# Réplica de solo lectura del catálogo en CouchDB.
VITE_CATALOGO_URL=http://localhost:15984/catalogo
VITE_CATALOGO_USER=cliente
VITE_CATALOGO_PASSWORD=cambiar-cliente

# `activado` exige login real; `desactivado` omite el login (solo desarrollo).
VITE_AUTH=activado
